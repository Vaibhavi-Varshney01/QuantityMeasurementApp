## Ignore Visual Studio temporary files, build results, and user-specific files

# Build Folders
bin/
obj/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Rider
.idea/

# OS Generated Files
.DS_Store
Thumbs.db

# NuGet
*.nupkg
*.snupkg
packages/

# Dotnet publish
publish/

# Logs
*.log